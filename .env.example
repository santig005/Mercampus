# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore: nunca subas secretos reales al repo.
#
# Los marcadores van entre <> a propósito: un valor con la forma real de una
# clave (sk_test_..., pk_test_...) dispara el escáner de secretos de GitHub y
# bloquea el push, aunque sea inventado.

# --- Base de datos -----------------------------------------------------------
# Cluster de DESARROLLO. `npm run seed` borra las colecciones que siembra,
# así que jamás apuntes esto a producción.
MONGO_URI=mongodb://localhost:27017/mercampus

# --- Clerk (autenticación) ---------------------------------------------------
# Desde el dashboard de Clerk. La publishable key es pública por diseño;
# la secret key NO.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<publishable key de Clerk>
CLERK_SECRET_KEY=<secret key de Clerk>

# Rutas propias de login y registro. El SDK de Clerk las lee directo del
# entorno: ningún archivo de src/ las nombra, por eso faltaban aquí (T-113).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=<ruta de login, p. ej. /auth/login>
NEXT_PUBLIC_CLERK_SIGN_UP_URL=<ruta de registro, p. ej. /auth/register>

# Firma de los webhooks de Clerk (svix), usada por /api/webhooks.
WEBHOOK_SECRET=<signing secret del webhook>

# --- ImageKit ---------------------------------------------------------------
# Renombradas en T-11b. Si tu .env todavía dice NEXT_PUBLIC_IMAGEKIT_KEY,
# PRIVATE_KEY_IMAGEKIT o NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT, renómbralas: con
# los nombres viejos las subidas fallan con un 500. Lo mismo en Vercel, donde
# la privada se llamaba distinto: NEXT_PUBLIC_PRIVATE_KEY_IMAGEKIT. Al crearla
# de nuevo, márcala como Sensitive (la tabla completa está en T-11b).
# SIN prefijo NEXT_PUBLIC_: solo se usan en route handlers. Con el prefijo,
# bastaria que un componente 'use client' importara utils/imagekit.js para
# publicar la clave privada en el bundle.
IMAGEKIT_PUBLIC_KEY=<public key de ImageKit>
IMAGEKIT_PRIVATE_KEY=<private key de ImageKit>
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<tu_id>

# --- Cloudinary --------------------------------------------------------------
# Renombradas en T-11b (antes NEXT_PUBLIC_CLOUDINARY_*). Mismo criterio. Cloudinary e ImageKit conviven; T-35 decide con cual quedarse.
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key de Cloudinary>
CLOUDINARY_API_SECRET=<api secret de Cloudinary>

# --- App ---------------------------------------------------------------------
# Base para las llamadas de services/api.js. Antipatrón que T-31/T-32 eliminan.
NEXT_PUBLIC_URL=http://localhost:3000

# --- Analítica (opcional) ----------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# --- Cron (Vercel) ------------------------------------------------------------
# Vercel manda esto solo en el header Authorization de sus propias llamadas de
# cron (ver vercel.json). GET /api/sellers/availability lo exige para que
# nadie más pueda disparar la actualización de disponibilidad.
# OJO: el disparador real es .github/workflows/availability-cron.yml (cada 10
# min), y necesita un secret del repo en GitHub con este MISMO valor. Hace
# falta en dos sitios: Vercel y GitHub. Sin los dos, responde 401 (T-14).
CRON_SECRET=<valor secreto, generalo con `openssl rand -hex 32`>
