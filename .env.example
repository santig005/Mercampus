# Copia este archivo a .env y rellena los valores.
# .env está en .gitignore: nunca subas secretos reales al repo.
#
# Los marcadores van entre <> a propósito: un valor con la forma real de una
# clave (sk_test_..., pk_test_...) dispara el escáner de secretos de GitHub y
# bloquea el push, aunque sea inventado.

# --- Base de datos -----------------------------------------------------------
# Cluster de DESARROLLO. `npm run seed` borra las colecciones que siembra,
# así que jamás apuntes esto a producción.
MONGO_URI=mongodb://localhost:27017/mercampus

# --- Clerk (autenticación) ---------------------------------------------------
# Desde el dashboard de Clerk. La publishable key es pública por diseño;
# la secret key NO.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=<publishable key de Clerk>
CLERK_SECRET_KEY=<secret key de Clerk>

# Firma de los webhooks de Clerk (svix), usada por /api/webhooks.
WEBHOOK_SECRET=<signing secret del webhook>

# --- ImageKit ----------------------------------------------------------------
# OJO: NEXT_PUBLIC_PRIVATE_KEY_IMAGEKIT es una clave PRIVADA con prefijo
# NEXT_PUBLIC_, así que Next la inyecta en el bundle del navegador. Es una fuga
# real y está pendiente de arreglo en T-11b. El nombre se mantiene mientras
# tanto porque el código lo lee así.
NEXT_PUBLIC_IMAGEKIT_KEY=<public key de ImageKit>
NEXT_PUBLIC_PRIVATE_KEY_IMAGEKIT=<private key de ImageKit>
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<tu_id>

# --- Cloudinary --------------------------------------------------------------
# Mismo problema que arriba: NEXT_PUBLIC_CLOUDINARY_API_SECRET es un secreto
# expuesto al cliente. También pendiente en T-11b.
# Cloudinary e ImageKit conviven; T-35 decide con cuál quedarse.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=<cloud name>
NEXT_PUBLIC_CLOUDINARY_API_KEY=<api key de Cloudinary>
NEXT_PUBLIC_CLOUDINARY_API_SECRET=<api secret de Cloudinary>

# --- App ---------------------------------------------------------------------
# Base para las llamadas de services/api.js. Antipatrón que T-31/T-32 eliminan.
NEXT_PUBLIC_URL=http://localhost:3000

# --- Analítica (opcional) ----------------------------------------------------
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
